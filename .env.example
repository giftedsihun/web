# Copy this file to .env for Docker Compose. Do not commit .env.
# Generate a long random value, for example:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
PUBLIC_SEARCH_ADMIN_TOKEN=

# Optional browser origins, comma-separated. Leave blank to deny cross-origin requests.
PUBLIC_SEARCH_CORS_ORIGINS=
PUBLIC_SEARCH_MAX_CONCURRENT_CRAWLS=2

# Identify the crawler with an operator-managed info/contact page in production.
PUBLIC_SEARCH_CRAWLER_USER_AGENT=AtlasPublicSearchBot/0.1 (+https://example.com/crawler)

# Optional Supabase account/sync foundation. The service role key is server-only.
SUPABASE_URL=
# Set this to the Supabase publishable (anon) key. It is safe for the desktop
# client; never put SUPABASE_SERVICE_ROLE_KEY in a packaged desktop app.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
